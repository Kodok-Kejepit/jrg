package sunting_sorot

// Penyorot sintaks JRG per baris, dengan KEADAAN yang dibawa ke baris berikutnya: komentar
// blok bersarang, string mentah, dan template `«…»`/`"""…"""` boleh membentang banyak baris.
// Ia tidak pernah gagal — kode yang belum selesai diketik tetap disorot sebisanya.
import "sunting/aksara"

const KUNCI = {
    "as": 1, "break": 1, "case": 1, "chan": 1, "const": 1, "continue": 1, "default": 1,
    "defer": 1, "else": 1, "enum": 1, "extern": 1, "fn": 1, "for": 1, "go": 1, "if": 1,
    "impl": 1, "import": 1, "in": 1, "let": 1, "loop": 1, "match": 1, "move": 1, "mut": 1,
    "package": 1, "pub": 1, "return": 1, "select": 1, "self": 1, "spawn": 1, "struct": 1,
    "trait": 1, "var": 1, "where": 1, "while": 1,
}

const TIPE = {
    "int": 1, "uint": 1, "float": 1, "bool": 1, "string": 1, "str": 1, "rune": 1, "byte": 1,
    "array": 1, "dict": 1, "tuple": 1, "unit": 1, "function": 1, "closure": 1,
    "i8": 1, "i16": 1, "i32": 1, "i64": 1, "i128": 1, "isize": 1,
    "u8": 1, "u16": 1, "u32": 1, "u64": 1, "u128": 1, "usize": 1, "f32": 1, "f64": 1,
    "Option": 1, "Result": 1, "Self": 1,
}

const NILAI = { "true": 1, "false": 1, "nil": 1, "Some": 1, "None": 1, "Ok": 1, "Err": 1 }

/// Semua kata yang disorot, untuk saran pelengkapan.
pub fn kata_bahasa() {
    return dict::keys(KUNCI) + dict::keys(TIPE) + dict::keys(NILAI)
}

fn di(k, i, c) { return i < len(k) && k[i] == c }

/// Posisi sesudah penutup komentar blok yang dibuka `dalam` lapis, mulai dari `i`.
/// Menjawab `[posisi, sisa_lapis]`; sisa lebih dari nol berarti masih terbuka di ujung baris.
fn lewati_komentar(k, i, dalam) {
    let n = len(k)
    var j = i
    var d = dalam
    while j < n && d > 0 {
        if k[j] == '/' && di(k, j + 1, '*') { d = d + 1; j = j + 2 }
        else if k[j] == '*' && di(k, j + 1, '/') { d = d - 1; j = j + 2 }
        else { j = j + 1 }
    }
    return [j, d]
}

/// Sorot isi template mulai `i` sampai penutupnya; `${…}` di dalamnya berjenis `i`.
/// Menjawab `[rentang, posisi, tertutup]`.
fn template(k, i, tutup3) {
    let n = len(k)
    var r = []
    var j = i
    var awal = i
    while j < n {
        let habis = tutup3 $ (k[j] == '"' && di(k, j + 1, '"') && di(k, j + 2, '"')) : k[j] == '»'
        if habis {
            let akhir = tutup3 $ j + 3 : j + 1
            r = r + [[awal, akhir, "s"]]
            return [r, akhir, true]
        }
        if k[j] == '$' && di(k, j + 1, '{') {
            if j > awal { r = r + [[awal, j, "s"]] }
            var d = 0
            var m = j + 1
            while m < n {
                if k[m] == '{' { d = d + 1 }
                if k[m] == '}' {
                    d = d - 1
                    if d == 0 { m = m + 1; break }
                }
                m = m + 1
            }
            r = r + [[j, m, "i"]]
            j = m
            awal = m
            continue
        }
        j = j + 1
    }
    if n > awal { r = r + [[awal, n, "s"]] }
    return [r, n, false]
}

/// Sorot satu baris. `awal` adalah keadaan di awal baris: "" biasa, "k<n>" di dalam
/// komentar blok sedalam n, "t"/"q" di dalam template, "b" di dalam string mentah.
/// Menjawab `[rentang, keadaan_akhir]`; tiap rentang `[mulai, sampai, jenis]`.
pub fn baris(teks, awal) {
    if teks == "" { return [[], awal] }
    let k = str::chars(teks)
    let n = len(k)
    var r = []
    var i = 0
    if str::starts_with(awal, "k") {
        let h = lewati_komentar(k, 0, str::to_int(str::slice(awal, 1)))
        r = r + [[0, h[0], "c"]]
        if h[1] > 0 { return [r, "k" + str::to_string(h[1])] }
        i = h[0]
    } else if awal == "t" || awal == "q" {
        let h = template(k, 0, awal == "q")
        r = h[0]
        if !h[2] { return [r, awal] }
        i = h[1]
    } else if awal == "b" {
        var j = 0
        while j < n && k[j] != '`' { j = j + 1 }
        if j >= n { return [[[0, n, "s"]], "b"] }
        r = [[0, j + 1, "s"]]
        i = j + 1
    }
    while i < n {
        let c = k[i]
        if c == ' ' || c == '\t' { i = i + 1; continue }
        if c == '/' && di(k, i + 1, '/') {
            r = r + [[i, n, "c"]]
            return [r, ""]
        }
        if c == '/' && di(k, i + 1, '*') {
            let h = lewati_komentar(k, i + 2, 1)
            r = r + [[i, h[0], "c"]]
            if h[1] > 0 { return [r, "k" + str::to_string(h[1])] }
            i = h[0]
            continue
        }
        if c == '"' && di(k, i + 1, '"') && di(k, i + 2, '"') {
            let h = template(k, i + 3, true)
            r = r + [[i, i + 3, "s"]] + h[0]
            if !h[2] { return [r, "q"] }
            i = h[1]
            continue
        }
        if c == '«' {
            let h = template(k, i + 1, false)
            r = r + [[i, i + 1, "s"]] + h[0]
            if !h[2] { return [r, "t"] }
            i = h[1]
            continue
        }
        if c == '"' {
            var j = i + 1
            while j < n {
                if k[j] == '\\' { j = j + 2 }
                else if k[j] == '"' { j = j + 1; break }
                else { j = j + 1 }
            }
            if j > n { j = n }
            r = r + [[i, j, "s"]]
            i = j
            continue
        }
        if c == '`' {
            var j = i + 1
            while j < n && k[j] != '`' { j = j + 1 }
            if j >= n {
                r = r + [[i, n, "s"]]
                return [r, "b"]
            }
            r = r + [[i, j + 1, "s"]]
            i = j + 1
            continue
        }
        if c == '\'' {
            // `'a'` dan `'\n'` adalah rune; `'luar` tanpa penutup adalah label loop.
            var j = i + 1
            if di(k, j, '\\') { j = j + 2 } else { j = j + 1 }
            while j < n && j < i + 12 && k[j] != '\'' && di(k, i + 1, '\\') { j = j + 1 }
            if di(k, j, '\'') {
                r = r + [[i, j + 1, "s"]]
                i = j + 1
                continue
            }
            var m = i + 1
            while m < n && aksara::kata(k[m]) { m = m + 1 }
            r = r + [[i, m, "k"]]
            i = math::max(m, i + 1)
            continue
        }
        if aksara::digit(c) {
            var j = i + 1
            while j < n && (aksara::kata(k[j]) || (k[j] == '.' && j + 1 < n && aksara::digit(k[j + 1]))) {
                j = j + 1
            }
            r = r + [[i, j, "a"]]
            i = j
            continue
        }
        if c == '_' || str::is_alpha(c) {
            var j = i + 1
            while j < n && aksara::kata(k[j]) { j = j + 1 }
            let kata = str::slice(teks, i, j)
            if dict::has(KUNCI, kata) { r = r + [[i, j, "k"]] }
            else if dict::has(NILAI, kata) { r = r + [[i, j, "n"]] }
            else if dict::has(TIPE, kata) { r = r + [[i, j, "t"]] }
            else if di(k, j, ':') && di(k, j + 1, ':') { r = r + [[i, j, "m"]] }
            else if di(k, j, '(') { r = r + [[i, j, "f"]] }
            else if c != '_' && str::upper(str::slice(kata, 0, 1)) == str::slice(kata, 0, 1) {
                // HURUF_BESAR semua adalah konstanta; Huruf Awal Besar adalah tipe.
                let konstanta = j - i > 1 && str::upper(kata) == kata
                r = r + [[i, j, konstanta $ "n" : "t"]]
            }
            i = j
            continue
        }
        i = i + 1
    }
    return [r, ""]
}

/// Keadaan di akhir baris tanpa menyusun rentangnya — jalur cepat untuk merambatkan
/// keadaan melewati baris yang tidak tampil.
pub fn keadaan_akhir(teks, awal) {
    if awal == "" {
        if !re::test("[/`«\"]", teks) { return "" }
        // String biasa dan komentar `//` berakhir di ujung baris; yang bisa membentang cuma
        // komentar blok, string mentah, dan template.
        if !(str::contains(teks, "/*") || str::contains(teks, "`") || str::contains(teks, "«") || str::contains(teks, "\"\"\"")) {
            return ""
        }
    } else if awal == "t" {
        if !str::contains(teks, "»") { return awal }
    } else if awal == "q" {
        if !str::contains(teks, "\"\"\"") { return awal }
    } else if awal == "b" {
        if !str::contains(teks, "`") { return awal }
    } else if !(str::contains(teks, "*/") || str::contains(teks, "/*")) {
        return awal
    }
    return baris(teks, awal)[1]
}
