// Pintasan di baris terbawah, diisi per KOLOM (dua baris): yang paling penting di kolom
// paling kiri, karena layar sempit cuma menampilkan beberapa kolom pertama.
const PINTASAN = [
    ["^S", "Simpan"], ["^Q", "Keluar"], ["Esc", "Bantuan"], ["^O", "Buka"],
    ["^F", "Cari"], ["^P", "Ganti"], ["^Z", "Urung"], ["^R", "Jalankan"],
    ["^C", "Salin"], ["^V", "Tempel"], ["^L", "Ke baris"], ["^Y", "Ulang"],
]

var PETA_TOMBOL = dict::new()

/// Perintah untuk tombol `t`, atau "" kalau tombol itu tidak dipetakan.
pub fn perintah(t) {
    if len(PETA_TOMBOL) == 0 {
        for _, b in TABEL { PETA_TOMBOL[b[0]] = b[1] }
    }
    return dict::get_or(PETA_TOMBOL, t, "")
}

pub fn pintasan() { return PINTASAN }

fn nama_bagian(b) {
    if b == "pgup" { return "PgUp" }
    if b == "pgdn" { return "PgDn" }
    if b == "" { return "-" }
    return str::upper(str::slice(b, 0, 1)) + str::slice(b, 1)
}

/// Tombol ditulis seperti di buku manual: `ctrl-s` jadi `^S`, `ctrl-pgdn` jadi `^PgDn`,
/// `alt-s` jadi `Alt-S`.
pub fn tulis(t) {
    var sisa = t
    var depan = ""
    if str::starts_with(sisa, "ctrl-") {
        depan = "^"
        sisa = str::slice(sisa, 5)
    }
    var bagian = []
    for _, b in str::split(sisa, "-") { bagian = bagian + [nama_bagian(b)] }
    return depan + arr::join(bagian, "-")
}

/// Baris-baris layar bantuan: tiap perintah berketerangan dengan semua tombolnya.
pub fn bantuan() {
    var keluar = []
    var grup = ""
    var i = 0
    while i < len(TABEL) {
        let b = TABEL[i]
        if b[2] != "" {
            if b[3] != grup {
                if grup != "" { keluar = keluar + [""] }
                grup = b[3]
                keluar = keluar + ["  " + grup]
            }
            var label = tulis(b[0])
            var j = i + 1
            while j < len(TABEL) && TABEL[j][1] == b[1] && TABEL[j][2] == "" {
                label = label + ", " + tulis(TABEL[j][0])
                j = j + 1
            }
            keluar = keluar + ["    " + str::pad_right(label, 20) + " " + b[2]]
        }
        i = i + 1
    }
    return keluar + [
        "",
        "  GERAK",
        "    panah, Home/End, PgUp/PgDn   gerak; tambah Shift untuk memilih",
        "    ^Kiri/^Kanan                 per kata        ^Home/^End   awal/akhir berkas",
        "    tetikus                      klik menaruh kursor, seret memilih, roda menggulung",
        "",
        "  Kurung dan kutip menutup sendiri; mengetik penutup yang sudah ada cuma melewatinya.",
        "  Home sekali ke awal isi baris, sekali lagi ke kolom pertama.",
    ]
}
