package main

// ============================================================================
// wokwok:: — library numerik JRG.

fn judul(t) { wok(""); wok("── " + t + " ──") }

pub fn main() {
    judul("Membuat array")
    let a = wokwok::arange(6)
    wok("arange(6)        :", a, "  dtype:", wokwok::dtype(a))
    let m = wokwok::reshape(a, [2, 3])
    wok("reshape [2,3]    :", m, "  shape:", wokwok::shape(m))
    wok("linspace(0,1,5)  :", wokwok::linspace(0, 1, 5))

    judul("Aritmetika ikut bentuk (broadcasting)")
    wok("m + 100          :", wokwok::add(m, 100))
    wok("m + [10,20,30]   :", wokwok::add(m, wokwok::array([10, 20, 30])))
    // Kolom: bentuk [2,1] disejajarkan ke [2,3]
    wok("m + kolom [2,1]  :", wokwok::add(m, wokwok::reshape(wokwok::array([100, 200]), [2, 1])))
    // Pembagian SELALU pecahan, bahkan antar-integer
    wok("m / 2            :", wokwok::div(m, 2))

    judul("Reduksi — argumen kedua = sumbu")
    wok("sum semua        :", wokwok::sum(m))
    wok("sum per kolom    :", wokwok::sum(m, 0))
    wok("sum per baris    :", wokwok::sum(m, 1))
    wok("mean / std       :", wokwok::mean(m), wokwok::std(m))
    wok("argmax           :", wokwok::argmax(wokwok::array([3, 9, 1])))

    judul("Memilih tanpa loop")
    let x = wokwok::array([-2.0, -1.0, 0.0, 1.0, 2.0])
    wok("x                :", x)
    wok("x > 0            :", wokwok::gt(x, 0))
    wok("relu(x)          :", wokwok::where(wokwok::gt(x, 0), x, 0.0))
    wok("clip(x, -1, 1)   :", wokwok::clip(x, -1, 1))

    judul("Aljabar linear")
    let A = wokwok::array([[2.0, 1.0], [1.0, 3.0]])
    let b = wokwok::array([5.0, 10.0])
    wok("A                :", A)
    wok("det(A)           :", wokwok::det(A))
    let s = wokwok::solve(A, b)
    wok("solve(A, b)      :", s)
    // Bukti: A @ s harus kembali ke b
    wok("A @ s (== b)     :", wokwok::matmul(A, s))
    wok("A @ inv(A)       :", wokwok::matmul(A, wokwok::inv(A)))

    judul("Ketelitian — dua pilihan yang sadar")
    let sejuta = wokwok::full([1000000], 0.1)
    wok("sum  1jt x 0.1   :", wokwok::sum(sejuta), " (eksak: 100000)")
    var campur = wokwok::full([1000000], 1.0)
    campur = wokwok::set(campur, 0, 1.0e16)
    wok("sum  campur skala:", wokwok::sum(campur))
    wok("fsum campur skala:", wokwok::fsum(campur), " <- f64 terdekat")

    judul("Nilai TIDAK pernah beralias")
    var p = wokwok::array([1.0, 2.0, 3.0])
    var q = p
    q = wokwok::set(q, 0, 99.0)
    wok("p (asli utuh)    :", p)
    wok("q (yang diubah)  :", q)

    judul("Kecepatan")
    let besar = wokwok::full([2000000], 1.5)
    let t0 = time::now_ms()
    let jum = wokwok::sum(besar)
    wok("sum 2 juta f64   :", time::now_ms() - t0, "ms  ->", jum)
    let g = wokwok::random([200, 200])
    let t1 = time::now_ms()
    let gg = wokwok::matmul(g, g)
    wok("matmul 200x200   :", time::now_ms() - t1, "ms  ->", wokwok::shape(gg))
}
