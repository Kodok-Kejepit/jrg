package main

// realistic mixed workload: synthesize a batch of records (structs), bucket
// them into a fixed array of accumulators, classify each with a match …

// Field-nya `pub` karena `main` membacanya dari luar; tanpa `pub` field
// bersifat private di JRG.
struct Record {
    pub id: int,
    pub amount: f64,
    pub weight: int,
    pub tier: int,
}

impl Record {
    fn score(self) -> f64 {
        return self.amount * (1.0 + (self.weight as f64) * 0.01)
    }
}

fn tier_of(weight: int) -> int {
    match weight % 7 {
        0 => 0,
        1 | 2 => 1,
        3..=5 => 2,
        _ => 3,
    }
}

fn fnv(h: uint, s: str) -> uint {
    var acc: uint = h
    for i in 0..len(s) {
        acc = math::wrap_mul(acc ^ (str::char_at(s, i) as uint), 1099511628211)
    }
    return acc
}

pub fn main() {
    let records: int = 12000000
    let buckets: int = 64

    var counts: [64]int
    var sums: [64]f64
    for b in 0..(buckets) {
        counts[b] = 0
        sums[b] = 0.0
    }

    var seed: uint = 88172645463325252
    var hash: uint = 1469598103934665603
    var tier_total: int = 0

    for r in 0..(records) {
        seed = math::wrap_add(math::wrap_mul(seed, 6364136223846793005), 1442695040888963407)
        let w: int = ((seed >> 33) % 1000) as int
        seed = math::wrap_add(math::wrap_mul(seed, 6364136223846793005), 1442695040888963407)
        let amt: f64 = ((seed >> 33) % 100000) as f64 * 0.01

        let rec: Record = Record {
            id: r,
            amount: amt,
            weight: w,
            tier: tier_of(w),
        }

        let b: int = rec.id % buckets
        counts[b] = counts[b] + 1
        sums[b] = sums[b] + rec.score()
        tier_total = tier_total + rec.tier

        if (r % 16 == 0) {
            let label: str = "rec" + str(rec.id % 1000) + "/t" + str(rec.tier)
            hash = fnv(hash, label)
        }
    }

    var total_count: int = 0
    var total_sum: f64 = 0.0
    for b in 0..(buckets) {
        total_count = total_count + counts[b]
        total_sum = total_sum + sums[b]
        hash = math::wrap_mul(hash ^ (counts[b] as uint), 1099511628211)
    }

    wok(total_count, tier_total, hash)
    wok(total_sum)
}
