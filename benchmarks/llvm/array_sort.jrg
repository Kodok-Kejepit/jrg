package main

// array-heavy: repeated in-place heapsort over a fixed-size array.

pub fn main() {
    let n: int = 2000
    let last: int = n - 1
    let rounds: int = 3000

    var hash: uint = 1469598103934665603
    var seed: uint = 88172645463325252
    var any_failed: bool = false
    var data: [2000]int

    for r in 0..rounds {
        for i in 0..n {
            seed = math::wrap_add(math::wrap_mul(seed, 6364136223846793005), 1442695040888963407)
            data[i] = (seed >> 1) as int
        }

        // ---- build heap ----
        var start: int = (n - 2) / 2
        while (start >= 0) {
            var root: int = start
            loop {
                var child: int = root * 2 + 1
                if (child > last) {
                    break
                }
                if (child + 1 <= last) {
                    if (data[child] < data[child + 1]) {
                        child = child + 1
                    }
                }
                if (data[root] < data[child]) {
                    let tmp: int = data[root]
                    data[root] = data[child]
                    data[child] = tmp
                    root = child
                } else {
                    break
                }
            }
            start = start - 1
        }

        // ---- drain heap ----
        var end: int = last
        while (end > 0) {
            let tmp0: int = data[0]
            data[0] = data[end]
            data[end] = tmp0
            end = end - 1

            var root: int = 0
            loop {
                var child: int = root * 2 + 1
                if (child > end) {
                    break
                }
                if (child + 1 <= end) {
                    if (data[child] < data[child + 1]) {
                        child = child + 1
                    }
                }
                if (data[root] < data[child]) {
                    let tmp: int = data[root]
                    data[root] = data[child]
                    data[child] = tmp
                    root = child
                } else {
                    break
                }
            }
        }

        var prev: int = data[0]
        for i in 0..n {
            if (data[i] < prev) {
                any_failed = true
            }
            prev = data[i]
            hash = math::wrap_mul(hash ^ (data[i] as uint), 11400714819323198485)
        }
    }

    if any_failed {
        wok("SORT_FAILED")
    } else {
        wok(hash)
    }
}
